# Copy to .env and adjust. All settings use the KTI_ prefix.
# Port 5433 here because a Docker container may already hold 5432. Use your own PostgreSQL port.
KTI_DATABASE_URL=postgresql://kti:kti_dev_password@localhost:5433/kti

# KTI_SECRET_KEY=change-me-in-production
# KTI_DEBUG=true
# KTI_ALLOWED_HOSTS=localhost,127.0.0.1
# KTI_SECURE_COOKIES=false          # set true when served over HTTPS

# Traffic levels (extra delay in minutes on a road) - SRS section 4.3.2
# KTI_FREE_FLOW_MAX_DELAY=2
# KTI_MODERATE_MAX_DELAY=7
# KTI_HEAVY_MAX_DELAY=15
# KTI_ALERT_DELAY_THRESHOLD=10
# KTI_SESSION_TIMEOUT_MINUTES=15
# KTI_INCIDENT_REPORT_RATE=5/hour
# KTI_SIMULATION_SCENARIO=auto
# KTI_SIMULATION_INTERVAL_SECONDS=60
